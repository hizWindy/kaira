"""
core/logger.py

Terminal-only structured logger for {{ project_name }}.
Uses loguru — all output goes to stdout only, no log files.
"""

import sys
from loguru import logger

# Remove loguru's default handler before configuring our own
logger.remove()

logger.add(
    sys.stdout,
    format=(
        "<green>{time:YYYY-MM-DD HH:mm:ss}</green> | "
        "<level>{level: <8}</level> | "
        "<cyan>{name}</cyan>:<cyan>{function}</cyan> | "
        "<level>{message}</level>"
    ),
    level="INFO",
    colorize=True,
    enqueue=True,
)

__all__ = ["logger"]
