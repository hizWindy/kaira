"""Liveness, readiness and metrics endpoints for {{ project_name }}.

Generated by Kaira. These routes are **added beside** ``/health`` — they do not
replace it, and nothing in this file touches it. Docker's ``HEALTHCHECK`` and
whatever your deployment platform is already pointed at ``/health`` keep working
exactly as before.

The split exists because "is the process alive" and "can this instance serve
traffic" are different questions with different answers, and answering both with
one endpoint gets you restarted for a database blip:

``{{ liveness_route }}``  liveness — the process is up and its event loop is
                    turning. Checks nothing external, so a slow database can
                    never convince an orchestrator to kill a healthy process.
``{{ readiness_route }}``  readiness — dependencies are reachable, so this
                    instance should stay in the load-balancer pool. Returns 503
                    when they are not, which removes the instance instead of
                    restarting it.
``{{ metrics_route }}``  Prometheus exposition. Counts and timings only.

Security posture — identical to ``/health``
-------------------------------------------
* Unauthenticated. A kubelet and a Prometheus scraper have no credentials, and
  gating these behind auth is how liveness probes end up disabled entirely.
* Rate limited at {{ probe_rate_limit }} so a 1-second probe interval never 429s.
* No DSN, no secret, no stack trace, no dependency version. ``{{ readiness_route }}``
  reports the literal string ``ok`` or ``unavailable`` per dependency and nothing
  else — the reason lives in the server log, where it is already written.
"""

from __future__ import annotations

from fastapi import APIRouter, Response, status
from slowapi import Limiter  # type: ignore[import]
from slowapi.util import get_remote_address  # type: ignore[import]
from starlette.requests import Request

from core.metrics import dependency_health, render_prometheus

router = APIRouter(tags=["monitoring"])
limiter = Limiter(key_func=get_remote_address)


@router.get(
    "{{ liveness_route }}",
    summary="Liveness probe",
    include_in_schema=True,
)
@limiter.limit("{{ probe_rate_limit }}")
async def liveness(request: Request) -> dict:
    """Return ``{"status": "alive"}`` if this process can serve a request.

    Intentionally the cheapest endpoint in the application: no database, no
    cache, no disk. If it answers, the process is healthy enough to keep. If it
    does not, restarting is the correct remedy — which is exactly the decision a
    liveness probe is allowed to make.

    Args:
        request: Incoming request (required by the slowapi rate limiter).

    Returns:
        A dict with a single ``status`` key.
    """
    return {"status": "alive"}


@router.get(
    "{{ readiness_route }}",
    summary="Readiness probe",
    include_in_schema=True,
)
@limiter.limit("{{ probe_rate_limit }}")
async def readiness(request: Request, response: Response) -> dict:
    """Report whether this instance's dependencies are reachable.

    Runs the same dependency checks ``/health`` already performs. Returns 503
    when any of them is unavailable, so the instance leaves the load-balancer
    pool without being restarted.

    Args:
        request: Incoming request (required by the slowapi rate limiter).
        response: Response object, used to set 503 on a failed check.

    Returns:
        ``{"status": ..., "dependencies": {"database": "ok", ...}}`` — coarse
        states only; never a connection string or an exception message.
    """
    dependencies = await dependency_health()
    ready = all(value == "ok" for value in dependencies.values())
    if not ready:
        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE
    return {
        "status": "ready" if ready else "not ready",
        "dependencies": dependencies,
    }


@router.get(
    "{{ metrics_route }}",
    summary="Prometheus metrics",
    include_in_schema=False,
)
@limiter.limit("{{ probe_rate_limit }}")
async def metrics(request: Request) -> Response:
    """Expose request counts, latencies and error counts in Prometheus format.

    Unauthenticated for the same reason ``/health`` is: a scraper cannot present
    credentials. What it exposes is aggregate counts and timings keyed by route
    *template* — no request bodies, no headers, no query strings, no user
    identifiers, and no resource ids.

    Args:
        request: Incoming request (required by the slowapi rate limiter).

    Returns:
        The exposition payload with the Prometheus content type.
    """
    body, content_type = render_prometheus()
    return Response(content=body, media_type=content_type)
