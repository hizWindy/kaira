"""Cloud → Local Fallback Engine — generated by Kaira Phase 5.

This file is generated into your project at core/fallback.py when you run:
    kaira cloud fallback enable

DO NOT edit by hand — re-run the command above to regenerate.

Provider: {{ provider }}
Local fallback engine: {{ local_engine }}
Probe interval: {{ probe_interval }}s (override with FALLBACK_PROBE_INTERVAL env var)

Modes
-----
CLOUD      Normal operation — all reads/writes hit the cloud database.
DEGRADED   Cloud unreachable → reads served locally, writes queued.
RECOVERED  Cloud back online → queued writes replayed, then → CLOUD.
"""

from __future__ import annotations

import asyncio
import fcntl
import json
import logging
import os
import stat
import uuid
from datetime import datetime
from enum import Enum
from pathlib import Path
from typing import Any, Optional

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

_PROBE_INTERVAL: int = int(os.environ.get("FALLBACK_PROBE_INTERVAL", "{{ probe_interval }}"))
_FAILURE_THRESHOLD: int = 3  # consecutive failures before DEGRADED
_PROVIDER: str = "{{ provider }}"
_LOCAL_ENGINE: str = "{{ local_engine }}"

_FALLBACK_DIR = Path(".kaira") / "fallback"
_WRITE_QUEUE = _FALLBACK_DIR / "write_queue.jsonl"
_CONFLICTS = _FALLBACK_DIR / "conflicts.jsonl"
_MIRROR_DB = Path(".kaira") / "fallback.db"
_MODE_FILE = _FALLBACK_DIR / ".mode"


# ---------------------------------------------------------------------------
# FallbackMode enum
# ---------------------------------------------------------------------------


class FallbackMode(str, Enum):
    """Operational mode of the cloud connection."""

    CLOUD = "CLOUD"
    DEGRADED = "DEGRADED"
    RECOVERED = "RECOVERED"


# ---------------------------------------------------------------------------
# FallbackManager — singleton state machine
# ---------------------------------------------------------------------------


class FallbackManager:
    """Manages the cloud ↔ local fallback state machine.

    Use :func:`get_manager` to obtain the singleton instance from FastAPI app
    state rather than constructing directly.

    Security notes:
    - Write queue files are created with 0600 permissions.
    - Queue contents are never logged.
    - Queued writes never include raw passwords (hashing happens in the
      service layer before reaching this manager).
    - Status reporting shows counts only, never row data.
    """

    def __init__(self) -> None:
        self._mode: FallbackMode = FallbackMode.CLOUD
        self._consecutive_failures: int = 0
        self._mode_since: datetime = datetime.utcnow()
        self._probe_task: Optional[asyncio.Task] = None  # type: ignore[type-arg]
        self._ensure_dirs()

    # ------------------------------------------------------------------
    # Startup / shutdown (FastAPI lifespan)
    # ------------------------------------------------------------------

    def start_probe(self) -> None:
        """Start the background health probe loop.

        Call from the FastAPI lifespan startup handler.
        """
        self._probe_task = asyncio.create_task(self._probe_loop())

    async def stop_probe(self) -> None:
        """Cancel the background health probe loop.

        Call from the FastAPI lifespan shutdown handler.
        """
        if self._probe_task and not self._probe_task.done():
            self._probe_task.cancel()
            try:
                await self._probe_task
            except asyncio.CancelledError:
                pass

    # ------------------------------------------------------------------
    # Mode access
    # ------------------------------------------------------------------

    @property
    def mode(self) -> FallbackMode:
        """Current operational mode."""
        return self._mode

    @property
    def mode_header(self) -> str:
        """Value for the ``X-Kaira-Mode`` response header."""
        return self._mode.value.lower()

    def is_degraded(self) -> bool:
        """Return True when in DEGRADED mode."""
        return self._mode == FallbackMode.DEGRADED

    # ------------------------------------------------------------------
    # Write queue
    # ------------------------------------------------------------------

    def enqueue_write(self, operation: str, data: dict[str, Any]) -> str:
        """Append a write operation to the durable queue.

        Each entry carries a UUID for idempotent replay.  The file is
        fsynced after every write to prevent data loss on crashes.

        Args:
            operation: HTTP method or operation name (e.g. ``"POST"``, ``"PATCH"``).
            data: Serialisable payload dict.  Must NOT contain raw passwords.

        Returns:
            The UUID assigned to this queued write.
        """
        write_id = str(uuid.uuid4())
        entry = {
            "id": write_id,
            "operation": operation,
            "data": data,
            "queued_at": datetime.utcnow().isoformat() + "Z",
        }
        self._append_to_file(_WRITE_QUEUE, entry)
        return write_id

    def queue_size(self) -> int:
        """Return the number of entries currently in the write queue."""
        return self._count_lines(_WRITE_QUEUE)

    def conflict_size(self) -> int:
        """Return the number of entries in the conflict log."""
        return self._count_lines(_CONFLICTS)

    # ------------------------------------------------------------------
    # Replay
    # ------------------------------------------------------------------

    async def replay_queue(self, cloud_writer: Any) -> tuple[int, int]:
        """Attempt to replay all queued writes against the cloud.

        Args:
            cloud_writer: Callable ``async (entry: dict) -> bool`` that applies
                one write to the cloud and returns True on success, False on
                idempotency skip (already applied), or raises on conflict.

        Returns:
            ``(replayed_count, conflict_count)`` tuple.
        """
        if not _WRITE_QUEUE.exists():
            return 0, 0

        lines = _WRITE_QUEUE.read_text(encoding="utf-8").splitlines()
        remaining: list[str] = []
        replayed = 0
        conflicts = 0

        for line in lines:
            if not line.strip():
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                remaining.append(line)
                continue

            try:
                applied = await cloud_writer(entry)
                if applied:
                    replayed += 1
                # If not applied (idempotent skip), drop from queue silently
            except ConflictError as exc:
                # Move conflicting entry to conflicts.jsonl — never silently overwrite
                conflict_entry = {**entry, "conflict_reason": str(exc)}
                self._append_to_file(_CONFLICTS, conflict_entry)
                conflicts += 1
            except Exception:
                # Transient error — keep in queue for next attempt
                remaining.append(line)

        # Rewrite queue with only remaining entries
        _WRITE_QUEUE.write_text("\n".join(remaining) + ("\n" if remaining else ""), encoding="utf-8")

        return replayed, conflicts

    # ------------------------------------------------------------------
    # Probe loop (private)
    # ------------------------------------------------------------------

    async def _probe_loop(self) -> None:
        """Background task: probe cloud health every _PROBE_INTERVAL seconds."""
        while True:
            try:
                await asyncio.sleep(_PROBE_INTERVAL)
                reachable = await self._ping_cloud()
                if reachable:
                    self._on_success()
                else:
                    self._on_failure()
            except asyncio.CancelledError:
                break
            except Exception as exc:
                logger.debug("Probe error (non-fatal): %s", exc)

    async def _ping_cloud(self) -> bool:
        """Lightweight cloud reachability check.

        Override in tests with a mock to force CLOUD/DEGRADED transitions.

        Returns:
            True if the cloud is reachable.
        """
        import socket

        loop = asyncio.get_event_loop()
        try:
            {% if provider == "supabase" %}
            db_url = os.environ.get("SUPABASE_DB_URL_DIRECT") or os.environ.get("DATABASE_URL", "")
            import re
            m = re.search(r"@([^:/]+)[:/](\d+)?", db_url)
            if not m:
                return False
            host, port = m.group(1), int(m.group(2) or 5432)
            {% elif provider == "atlas" %}
            uri = os.environ.get("ATLAS_URI", os.environ.get("DATABASE_URL", ""))
            import re
            m = re.search(r"mongodb\+srv://[^@]+@([^/]+)", uri, re.IGNORECASE)
            if not m:
                return False
            host, port = m.group(1), 27017
            {% else %}
            # Firebase: check credentials file is accessible
            cred_path = os.environ.get("FIREBASE_CREDENTIALS_PATH", "")
            return bool(cred_path and Path(cred_path).exists())
            {% endif %}
            await loop.run_in_executor(
                None,
                lambda: socket.create_connection((host, port), timeout=5.0).__exit__(None, None, None),
            )
            return True
        except Exception:
            return False

    def _on_success(self) -> None:
        """Handle a successful probe result."""
        self._consecutive_failures = 0
        if self._mode == FallbackMode.DEGRADED:
            self._set_mode(FallbackMode.RECOVERED)
            logger.info("Cloud connection restored — entering RECOVERED mode.")
        elif self._mode == FallbackMode.RECOVERED:
            self._set_mode(FallbackMode.CLOUD)
            logger.info("Write queue replayed — returning to CLOUD mode.")

    def _on_failure(self) -> None:
        """Handle a failed probe result."""
        self._consecutive_failures += 1
        if (
            self._consecutive_failures >= _FAILURE_THRESHOLD
            and self._mode == FallbackMode.CLOUD
        ):
            self._set_mode(FallbackMode.DEGRADED)
            logger.warning(
                "Cloud unreachable after %d consecutive probe failures — DEGRADED mode.",
                _FAILURE_THRESHOLD,
            )

    def _set_mode(self, mode: FallbackMode) -> None:
        """Atomically update the mode and persist it to disk."""
        self._mode = mode
        self._mode_since = datetime.utcnow()
        try:
            _MODE_FILE.write_text(
                f"{mode.value}|{self._mode_since.strftime('%H:%M')}",
                encoding="utf-8",
            )
        except OSError:
            pass  # Non-fatal — mode still held in memory

    # ------------------------------------------------------------------
    # Directory / file helpers
    # ------------------------------------------------------------------

    def _ensure_dirs(self) -> None:
        """Create fallback directories with secure permissions."""
        try:
            _FALLBACK_DIR.mkdir(parents=True, exist_ok=True)
            try:
                os.chmod(_FALLBACK_DIR, stat.S_IRWXU)  # 0700
            except OSError:
                pass  # Windows
        except OSError:
            pass

    def _append_to_file(self, path: Path, entry: dict) -> None:
        """Append *entry* as a JSON line to *path*, with fsync.

        The file is created with 0600 permissions and fsynced after each
        write to prevent data loss.  Contents are never logged.
        """
        line = json.dumps(entry, default=str) + "\n"
        try:
            flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT
            fd = os.open(str(path), flags, mode=stat.S_IRUSR | stat.S_IWUSR)
            try:
                os.write(fd, line.encode("utf-8"))
                os.fsync(fd)
            finally:
                os.close(fd)
        except OSError as exc:
            logger.error("Failed to write to fallback queue: %s", exc)

    def _count_lines(self, path: Path) -> int:
        """Count non-empty lines in a JSONL file."""
        if not path.exists():
            return 0
        try:
            return sum(1 for line in path.read_text(encoding="utf-8").splitlines() if line.strip())
        except OSError:
            return 0


# ---------------------------------------------------------------------------
# ConflictError
# ---------------------------------------------------------------------------


class ConflictError(Exception):
    """Raised during replay when a queued write conflicts with cloud state.

    Conflicting entries are moved to conflicts.jsonl — never silently
    overwritten.
    """


# ---------------------------------------------------------------------------
# FastAPI dependency
# ---------------------------------------------------------------------------


def get_manager(request: Any) -> FallbackManager:
    """FastAPI dependency — resolve FallbackManager from app state.

    Add to your FastAPI app::

        app.state.fallback = FallbackManager()

    Then use in route handlers::

        manager: FallbackManager = Depends(get_manager)
    """
    return request.app.state.fallback  # type: ignore[no-any-return]


# ---------------------------------------------------------------------------
# Status helper (safe — counts only, never row data)
# ---------------------------------------------------------------------------


def get_status_counts() -> dict[str, int | str]:
    """Return fallback status counts suitable for kaira cloud fallback status.

    Returns a dict with 'queue_size' and 'conflict_size' only.
    Never includes row contents for security.
    """
    mgr = FallbackManager.__new__(FallbackManager)
    return {
        "mode": "unknown",
        "queue_size": mgr._count_lines(_WRITE_QUEUE),
        "conflict_size": mgr._count_lines(_CONFLICTS),
    }
