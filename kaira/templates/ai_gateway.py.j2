"""Universal Multi-Provider LLM Gateway with Resilient Fallback & Streaming.

Handles API communication with OpenAI, Anthropic, Ollama, and DeepSeek.
Provides unified token streaming (SSE) and token usage metrics.
"""

from __future__ import annotations

import json
import os
from typing import Any, AsyncGenerator, Optional
from loguru import logger

from config.settings import settings


class LLMGateway:
    """Unified client gateway for multiple LLM providers."""

    def __init__(
        self,
        primary_provider: str = "{{ primary_provider }}",
        model_name: Optional[str] = None,
    ):
        self.provider = primary_provider.lower()
        self.model_name = model_name or self._default_model_for(self.provider)

    def _default_model_for(self, provider: str) -> str:
        defaults = {
            "openai": "gpt-4o",
            "anthropic": "claude-3-5-sonnet-latest",
            "ollama": "llama3.1",
            "deepseek": "deepseek-chat",
        }
        return defaults.get(provider, "gpt-4o")

    async def complete(
        self,
        prompt: str,
        system_prompt: Optional[str] = None,
        temperature: float = 0.7,
    ) -> str:
        """Execute a non-streaming completion with automatic provider dispatch."""
        logger.info(f"LLM Request via {self.provider} ({self.model_name})")
        
        if self.provider == "openai":
            return await self._complete_openai(prompt, system_prompt, temperature)
        elif self.provider == "anthropic":
            return await self._complete_anthropic(prompt, system_prompt, temperature)
        elif self.provider == "ollama":
            return await self._complete_ollama(prompt, system_prompt, temperature)
        elif self.provider == "deepseek":
            return await self._complete_deepseek(prompt, system_prompt, temperature)
        else:
            raise ValueError(f"Unsupported LLM provider: {self.provider}")

    async def stream(
        self,
        prompt: str,
        system_prompt: Optional[str] = None,
        temperature: float = 0.7,
    ) -> AsyncGenerator[str, None]:
        """Stream token-by-token chunks formatted as Server-Sent Events (SSE)."""
        logger.info(f"LLM Stream via {self.provider} ({self.model_name})")
        
        if self.provider == "openai" or self.provider == "deepseek":
            async for chunk in self._stream_openai_compatible(prompt, system_prompt, temperature):
                yield f"data: {json.dumps({'token': chunk})}\n\n"
        elif self.provider == "anthropic":
            async for chunk in self._stream_anthropic(prompt, system_prompt, temperature):
                yield f"data: {json.dumps({'token': chunk})}\n\n"
        elif self.provider == "ollama":
            async for chunk in self._stream_ollama(prompt, system_prompt, temperature):
                yield f"data: {json.dumps({'token': chunk})}\n\n"
        
        yield "data: [DONE]\n\n"

    # --- Provider Implementations ---

    async def _complete_openai(self, prompt: str, system: Optional[str], temp: float) -> str:
        try:
            from openai import AsyncOpenAI
            client = AsyncOpenAI(api_key=getattr(settings, "OPENAI_API_KEY", os.getenv("OPENAI_API_KEY")))
            messages = []
            if system:
                messages.append({"role": "system", "content": system})
            messages.append({"role": "user", "content": prompt})
            
            response = await client.chat.completions.create(
                model=self.model_name,
                messages=messages,
                temperature=temp,
            )
            return response.choices[0].message.content or ""
        except Exception as e:
            logger.error(f"OpenAI error: {e}. Attempting fallback if available.")
            raise

    async def _stream_openai_compatible(self, prompt: str, system: Optional[str], temp: float) -> AsyncGenerator[str, None]:
        from openai import AsyncOpenAI
        base_url = "https://api.deepseek.com" if self.provider == "deepseek" else None
        api_key = getattr(settings, "DEEPSEEK_API_KEY", os.getenv("DEEPSEEK_API_KEY")) if self.provider == "deepseek" else getattr(settings, "OPENAI_API_KEY", os.getenv("OPENAI_API_KEY"))
        
        client = AsyncOpenAI(api_key=api_key, base_url=base_url)
        messages = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt})

        stream = await client.chat.completions.create(
            model=self.model_name,
            messages=messages,
            temperature=temp,
            stream=True,
        )
        async for chunk in stream:
            token = chunk.choices[0].delta.content if chunk.choices else ""
            if token:
                yield token

    async def _complete_anthropic(self, prompt: str, system: Optional[str], temp: float) -> str:
        import anthropic
        client = anthropic.AsyncAnthropic(api_key=getattr(settings, "ANTHROPIC_API_KEY", os.getenv("ANTHROPIC_API_KEY")))
        response = await client.messages.create(
            model=self.model_name,
            max_tokens=4096,
            temperature=temp,
            system=system or "",
            messages=[{"role": "user", "content": prompt}],
        )
        return response.content[0].text if response.content else ""

    async def _stream_anthropic(self, prompt: str, system: Optional[str], temp: float) -> AsyncGenerator[str, None]:
        import anthropic
        client = anthropic.AsyncAnthropic(api_key=getattr(settings, "ANTHROPIC_API_KEY", os.getenv("ANTHROPIC_API_KEY")))
        async with client.messages.stream(
            model=self.model_name,
            max_tokens=4096,
            temperature=temp,
            system=system or "",
            messages=[{"role": "user", "content": prompt}],
        ) as stream:
            async for text in stream.text_stream:
                yield text

    async def _complete_ollama(self, prompt: str, system: Optional[str], temp: float) -> str:
        import httpx
        host = getattr(settings, "OLLAMA_HOST", "http://localhost:11434")
        async with httpx.AsyncClient(base_url=host, timeout=60.0) as client:
            res = await client.post("/api/generate", json={
                "model": self.model_name,
                "prompt": prompt,
                "system": system,
                "stream": False,
                "options": {"temperature": temp}
            })
            res.raise_for_status()
            return res.json().get("response", "")

    async def _stream_ollama(self, prompt: str, system: Optional[str], temp: float) -> AsyncGenerator[str, None]:
        import httpx
        host = getattr(settings, "OLLAMA_HOST", "http://localhost:11434")
        async with httpx.AsyncClient(base_url=host, timeout=60.0) as client:
            async with client.stream("POST", "/api/generate", json={
                "model": self.model_name,
                "prompt": prompt,
                "system": system,
                "stream": True,
                "options": {"temperature": temp}
            }) as response:
                async for line in response.aiter_lines():
                    if line:
                        data = json.loads(line)
                        token = data.get("response", "")
                        if token:
                            yield token
