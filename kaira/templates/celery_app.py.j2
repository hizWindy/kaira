"""Celery application for {{ project_name }}.

Generated by Kaira. All tasks are declared via the @celery_app.task decorator
or by importing from the tasks/ package.
"""
from __future__ import annotations

from celery import Celery
from core.config import settings  # type: ignore[import]

celery_app = Celery(
    "{{ project_name }}",
    broker=settings.CELERY_BROKER_URL,
    backend=settings.CELERY_RESULT_BACKEND,
    include=["tasks"],
)

celery_app.conf.update(
    task_serializer="json",
    accept_content=["json"],
    result_serializer="json",
    timezone="UTC",
    enable_utc=True,
    worker_hijack_root_logger=False,
    beat_schedule={
        {% for task in scheduled_tasks %}
        "{{ task.name }}": {
            "task": "tasks.{{ task.module }}.{{ task.func }}",
            "schedule": {{ task.schedule }},
        },
        {% endfor %}
    },
)
