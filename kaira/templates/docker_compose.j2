{% from "_docker_macros.j2" import service_block %}
# docker-compose.yml — DEVELOPMENT stack for {{ project_name }}.
#
# Generated by Kaira from the current project state:
#   database: {{ db_label }}{% if cache %} · cache: redis{% endif %}{% if task %} · tasks: celery{% endif %}{% if search %} · search: {{ search }}{% endif %}

#
# Services appear here because the matching feature is enabled in .kaira.json
# or scaffolded in the project.  After running `kaira cache init`,
# `kaira task init`, or `kaira integrate --provider search/...`, bring this file
# back in line with:
#
#   kaira docker sync
#
# Start it with `kaira docker up` — that picks this file and .env.development
# for you.  The `version:` key is intentionally absent: Compose v2 ignores it
# and warns when it is present.

services:
{% for svc in services %}
{{ service_block(svc) }}
{% endfor %}
{% if volume_names %}
volumes:
{% for name in volume_names %}
  {{ name }}:
{% endfor %}
{% endif %}
