version: "3.9"

services:
  app:
    build: .
    ports:
      - "8000:8000"
    env_file:
      - .env
    volumes:
      - .:/app
{% if db_type != "sqlite" %}    depends_on:
      - db
{% endif %}    read_only: true
    security_opt:
      - no-new-privileges:true
{% if db_type == "postgresql" %}
  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-kaira}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-kaira}
      POSTGRES_DB: ${POSTGRES_DB:-{{ project_slug }}}
    env_file:
      - .env
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

volumes:
  pgdata:
{% elif db_type == "mysql" %}
  db:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-kaira}
      MYSQL_USER: ${MYSQL_USER:-kaira}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-kaira}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-{{ project_slug }}}
    env_file:
      - .env
    ports:
      - "3306:3306"
    volumes:
      - mysqldata:/var/lib/mysql

volumes:
  mysqldata:
{% elif db_type == "mongodb" %}
  db:
    image: mongo:7
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_USER:-kaira}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD:-kaira}
      MONGO_INITDB_DATABASE: ${MONGO_DB:-{{ project_slug }}}
    env_file:
      - .env
    ports:
      - "27017:27017"
    volumes:
      - mongodata:/data/db

volumes:
  mongodata:
{% else %}
# SQLite is file-based — no separate database service required.
{% endif %}
