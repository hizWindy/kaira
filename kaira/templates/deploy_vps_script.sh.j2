#!/usr/bin/env bash
# VPS deployment script for {{ project_name }}
# Generated by Kaira. Credentials must be set as environment variables
# on the target server — never hardcoded in this script.
# Usage: bash deploy_vps.sh [user@host]

set -euo pipefail

HOST="${1:-}"
APP_DIR="/opt/{{ project_name }}"

if [[ -z "$HOST" ]]; then
  echo "Usage: $0 user@host"
  exit 1
fi

echo "Deploying {{ project_name }} to $HOST..."

# Sync files (excluding secrets and local env files)
rsync -avz \
  --exclude='.env*' \
  --exclude='.devflow/' \
  --exclude='__pycache__/' \
  --exclude='.git/' \
  . "$HOST:$APP_DIR/"

# Restart the app via systemd
ssh "$HOST" "cd $APP_DIR && pip install -r requirements.txt && systemctl restart {{ project_name }}"

echo "Deployment complete."
