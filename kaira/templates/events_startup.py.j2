"""FastAPI lifespan startup handler for {{ project_name }}.

Generated by Kaira. Registered via the FastAPI lifespan context manager —
not the deprecated @app.on_event("startup").
"""
from __future__ import annotations

from core.logger import logger  # type: ignore[import]


async def on_startup() -> None:
    """Run application startup tasks.

    Called once when the FastAPI application starts. Initialises all
    required connections and services in the correct order.
    """
    logger.info("Application starting up...")

    {% if cache_enabled %}
    # Initialise Redis cache — only if cache has been configured
    try:
        from core.cache import init_cache  # type: ignore[import]
        await init_cache()
        logger.info("Cache initialised successfully")
    except Exception as exc:
        logger.warning("Cache initialisation skipped: {}", type(exc).__name__)
    {% endif %}

    logger.info("Startup complete")
