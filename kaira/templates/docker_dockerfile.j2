# syntax=docker/dockerfile:1
# ============================================================================
# {{ project_name }} — generated by Kaira.
#
# Regenerate after the project changes (new database, cache, tasks, search):
#   kaira docker sync
#
# Recommended run flags:
#   docker run --init --read-only --security-opt no-new-privileges:true ...
#
# `--init` makes Docker run a minimal init process as PID 1, which forwards
# SIGTERM to the app for graceful shutdown and reaps zombie children.  It is
# built into Docker, so there is deliberately no `tini` installed here.
# ============================================================================

# Pinned to a full patch version.  A minor-only tag (python:{{ python_version.rsplit(".", 1)[0] }}) or `latest`
# moves underneath the project between builds, which is exactly the class of
# irreproducibility that shows up as "it built fine last month".
ARG PYTHON_VERSION={{ python_version }}

# ----------------------------------------------------------------------------
# Stage 1: builder — resolve and install dependencies
#
# Everything expensive or dirty happens here: compilers, headers, build caches.
# None of it is copied into stage 2, so none of it ships.
# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

{% if system_deps %}
# System build dependencies for {{ db_label }}.
#   --no-install-recommends  skips optional extras that would only add weight.
#   rm -rf /var/lib/apt/lists  runs in the SAME layer — a file deleted in a
#   later layer still exists in the earlier one and still costs image size.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
{% for dep in system_deps %}
        {{ dep }} \
{% endfor %}
    && rm -rf /var/lib/apt/lists/*

{% else %}
# {{ db_label }} uses a pure-Python driver — no compiler, no headers, nothing to
# install.  The apt-get block is omitted rather than left empty so the image has
# one fewer layer.

{% endif %}
# Dependency manifest is copied BEFORE the source tree.  This is the highest
# leverage caching habit there is: editing a router must not invalidate the
# layer that reinstalls every dependency.
COPY requirements.txt .

# --user installs into /root/.local — one self-contained tree the runtime stage
# copies wholesale.  Copying system site-packages instead would drag along
# build-only files that happen to live there.
# --no-cache-dir keeps pip's download cache out of the layer.
RUN pip install --no-cache-dir --user -r requirements.txt

# ----------------------------------------------------------------------------
# Stage 2: runtime — the image that actually ships
#
# No compiler, no apt lists, no pip cache, no build context leftovers.
# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim

WORKDIR /app

# Non-root user, created before the dependency copy so ownership is correct in
# one pass.  `adduser --system` makes a locked, no-login account — stronger than
# `adduser --disabled-password`, which still leaves a usable shell.
RUN addgroup --system app \
    && adduser --system --ingroup app --home /home/app app

# The builder installed as root, so the tree lives at /root/.local — which a
# non-root user cannot read.  It is relocated into the app user's home and
# PYTHONUSERBASE points Python at it, so no PYTHONPATH juggling is needed.
COPY --from=builder --chown=app:app /root/.local /home/app/.local

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUSERBASE=/home/app/.local \
    PATH=/home/app/.local/bin:$PATH

# Application source last: it changes on every commit, so it must sit above
# every layer that is expensive to rebuild.
COPY --chown=app:app . .

USER app

# Documentation contract only — EXPOSE publishes nothing by itself, but it tells
# every reader and every orchestrator which port this image speaks on.
EXPOSE {{ app_port }}

# Healthcheck lives in the image, not only in compose, so it travels with the
# image to any orchestrator.  urllib comes from the stdlib, which is why `curl`
# is not installed in the final stage just to answer one HTTP request.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:{{ app_port }}/health', timeout=2).status == 200 else 1)"]

# Exec form: the process becomes PID 1's direct child and receives SIGTERM
# itself.  Shell form would wrap it in /bin/sh, which swallows the signal and
# turns every graceful shutdown into a 10-second timeout and a SIGKILL.
# No --reload here: that is a development concern and the dev compose file
# overrides this command with it.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{ app_port }}"]
