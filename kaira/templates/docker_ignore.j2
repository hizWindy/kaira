# .dockerignore — generated by Kaira for {{ project_name }}.
#
# Everything listed here is excluded from the build context before the daemon
# ever sees it: smaller uploads, faster builds, and no chance of a secret or a
# stale virtualenv being baked into a layer.
#
# Regenerate with: kaira docker sync

# --- version control -------------------------------------------------------
.git
.gitignore
.gitattributes
.github/
.gitlab-ci.yml
bitbucket-pipelines.yml

# --- Python bytecode and build artefacts -----------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
*.whl
dist/
build/
.eggs/

# --- virtual environments --------------------------------------------------
venv/
.venv/
env/
ENV/

# --- secrets ---------------------------------------------------------------
# Runtime configuration is injected with --env-file or orchestrator secrets;
# a .env copied into a layer is readable forever, even if deleted later.
.env
.env.*
# The example file carries no values and documents the required keys, so it is
# explicitly allowed back in.
!.env.example

# --- Kaira project state ---------------------------------------------------
.kaira/
.kaira.json
.devflow/
.devflow.json

# --- editors and IDEs ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Docker's own files ----------------------------------------------------
# Excluded so the build context never contains the files that describe it.
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# --- tests, docs, and tooling caches ---------------------------------------
tests/
test/
docs/
*.md
!README.md
LICENSE
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- local databases and logs ----------------------------------------------
*.db
*.sqlite
*.sqlite3
*.log
logs/

# --- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
