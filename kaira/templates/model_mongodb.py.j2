"""
models/{{ snake_name }}.py

Beanie Document model for {{ model_name }} (MongoDB).
"""

from __future__ import annotations

import uuid
from datetime import datetime, timezone
{% if needs_optional %}
from typing import Optional
{% endif %}

from beanie import Document
from pydantic import ConfigDict, Field
{% for embedded in embedded_imports %}
from {{ models_dir }}.{{ to_snake(embedded) }} import {{ embedded }}
{% endfor %}


class {{ model_name }}(Document):
    """
    MongoDB document model for {{ model_name }}.

    Stored in the '{{ table_name }}' collection.
    """

    # Public identifier — UUID exposed externally, internal _id stays private
    uuid: str = Field(default_factory=lambda: str(uuid.uuid4()))

    # ── Business fields ───────────────────────────────────────────────────────
{% for field in fields %}
{% if field.is_embedded %}
{# Embedded documents are stored inline; a list defaults to empty rather than
   None so callers can append without a null check. #}
{% if field.is_list %}
    {{ field.name }}: list[{{ field.embedded_model }}] = Field(default_factory=list)
{% elif field.optional %}
    {{ field.name }}: Optional[{{ field.embedded_model }}] = None
{% else %}
    {{ field.name }}: {{ field.embedded_model }}
{% endif %}
{% elif field.optional %}
    {{ field.name }}: Optional[{{ field.python_type.replace("Optional[", "").rstrip("]") }}] = None
{% elif field.python_type == "datetime" %}
    {{ field.name }}: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))
{% elif field.python_type == "str" %}
    {{ field.name }}: str = Field(..., max_length=255)
{% elif field.python_type == "int" %}
    {{ field.name }}: int = Field(..., ge=0)
{% elif field.python_type == "float" %}
    {{ field.name }}: float = Field(..., ge=0.0)
{% else %}
    {{ field.name }}: {{ field.python_type }}
{% endif %}
{% endfor %}

    # ── Timestamps ────────────────────────────────────────────────────────────
    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))
    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))

    class Settings:
        """Beanie settings for this document."""

        name = "{{ table_name }}"   # MongoDB collection name
        use_revision = False

    # extra="allow" keeps keys that exist in the stored document but are not
    # declared above. Without it pydantic drops them on load, and the next
    # save writes the document back *without* them — silent data loss whenever
    # anything else writes to this collection (an older release, a migration,
    # a field removed from models.json). A document store is expected to hold
    # heterogeneous documents, so preserving unknown keys is the safe default.
    #
    # This affects the stored document only. The Create/Update request schemas
    # stay strict, so clients still cannot inject arbitrary fields.
    model_config = ConfigDict(populate_by_name=True, extra="allow")
