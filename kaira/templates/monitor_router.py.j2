"""Self-hosted mini dashboard for {{ project_name }}.

Two routes under Kaira's reserved namespace:

``GET {{ monitor_namespace }}``       the HTML page
``GET {{ monitor_namespace }}/data``  the JSON it polls

The ``/_kaira/`` prefix is reserved on purpose. Your API owns ``/api/{{ api_version }}/*``
and your root; a bare ``/monitor`` would collide the day someone generates a
``Monitor`` model. Nothing generated by Kaira will ever mount outside this prefix
without being asked to.

Why this is not public
----------------------
``/health`` is public because it says almost nothing: up, which engine, which
mode. This page says which of your routes are hot, which are failing, how many
auth attempts are being rejected and how close your database is to its plan
limit. That is a map of your system's soft spots, so it ships **off**, and it
cannot be turned on halfway:

* ``{{ env_enabled }}=true`` must be set, or both routes return 404 — the same
  answer an unmounted path gives, so probing cannot confirm the feature exists.
{% if dashboard_auth == "token" %}
* A bearer token matching ``{{ env_token }}`` must be presented. The comparison
  is constant-time, and an unset or short token disables the routes outright
  rather than accepting an empty string.
{% elif dashboard_auth == "reuse" %}
* The project's own auth guard (``auth.dependencies.get_current_user``) runs on
  both routes, so whoever may call your API may read this page — one identity
  system, not two.
{% else %}
* No auth strategy was recorded for this project, so both routes stay disabled.
  Re-run ``kaira monitor init --dashboard`` and choose a strategy.
{% endif %}

Scope
-----
Single worker. The numbers come from one process's memory (see
``core/metrics.py``) — accurate for development and small single-container
deployments, one worker's slice under ``gunicorn -w 4``. The page states this
on its own face rather than letting an operator infer an aggregate that was
never computed.
"""

from __future__ import annotations

import os
{% if dashboard_auth == "token" %}
import secrets
{% endif %}

from fastapi import APIRouter, Depends, HTTPException, Request, Response, status
from slowapi import Limiter  # type: ignore[import]
from slowapi.util import get_remote_address  # type: ignore[import]

from core.metrics import dashboard_payload
from core.monitor_dashboard import render_dashboard
{% if auth_guard %}
from auth.dependencies import get_current_user
{% endif %}

router = APIRouter(tags=["monitoring"], include_in_schema=False)
limiter = Limiter(key_func=get_remote_address)

MONITOR_NAMESPACE = "{{ monitor_namespace }}"
DATA_ROUTE = f"{MONITOR_NAMESPACE}/data"

MIN_TOKEN_LENGTH = 24
"""Shortest accepted ``{{ env_token }}``.

A four-character token on an internet-facing route is not a gate, it is a speed
bump; refusing to start the feature is more honest than pretending it is
protected.
"""


def monitor_enabled() -> bool:
    """True when ``{{ env_enabled }}`` explicitly opts this project in."""
    return os.getenv("{{ env_enabled }}", "").strip().lower() in {"1", "true", "yes"}


{% if dashboard_auth == "token" %}
def _configured_token() -> str:
    """Return the configured dashboard token, or ``""`` when unusable."""
    token = os.getenv("{{ env_token }}", "").strip()
    return token if len(token) >= MIN_TOKEN_LENGTH else ""


def _bearer(request: Request) -> str:
    """Extract the bearer credential from the Authorization header."""
    header = request.headers.get("Authorization", "")
    scheme, _, credential = header.partition(" ")
    return credential.strip() if scheme.lower() == "bearer" else ""
{% endif %}


def guard(request: Request) -> None:
    """Reject the request unless the dashboard is enabled and authorised.

    Disabled and unauthorised are answered differently on purpose. Disabled
    returns 404, which is indistinguishable from a route that was never mounted.
    Unauthorised returns 401, because at that point the caller already knows the
    route exists — they just have not proved who they are.

    Args:
        request: The incoming request.

    Raises:
        HTTPException: 404 when disabled, 401 when the credential is missing or
            wrong.
    """
    if not monitor_enabled():
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Not Found")
{% if dashboard_auth == "token" %}
    expected = _configured_token()
    if not expected:
        # A misconfigured token is a closed door, never an open one.
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Not Found")
    if not secrets.compare_digest(_bearer(request), expected):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Not authorised.",
            headers={"WWW-Authenticate": "Bearer"},
        )
{% elif dashboard_auth == "reuse" %}
    # Authorisation itself is enforced by the project's own guard, declared as a
    # route dependency below; this function only handles the enabled/disabled
    # switch so the two concerns stay separable.
    return None
{% else %}
    # No auth strategy recorded — the dashboard stays closed.
    raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Not Found")
{% endif %}


@router.get(
    MONITOR_NAMESPACE,
    summary="Kaira monitoring dashboard",
    response_class=Response,
)
@limiter.limit("60/minute")
async def dashboard(
    request: Request,
    _: None = Depends(guard),
{% if auth_guard %}
    current_user: dict = Depends(get_current_user),
{% endif %}
) -> Response:
    """Serve the dashboard page.

    Args:
        request: Incoming request (required by the slowapi rate limiter).

    Returns:
        A self-contained HTML document with no external requests, marked
        no-store so an operator's browser cache never holds a stale picture of
        production.
    """
    return Response(
        content=render_dashboard(DATA_ROUTE),
        media_type="text/html; charset=utf-8",
        headers={"Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow"},
    )


@router.get(
    DATA_ROUTE,
    summary="Kaira monitoring data",
)
@limiter.limit("120/minute")
async def dashboard_data(
    request: Request,
    _: None = Depends(guard),
{% if auth_guard %}
    current_user: dict = Depends(get_current_user),
{% endif %}
) -> dict:
    """Return the metrics payload the dashboard polls.

    Args:
        request: Incoming request (required by the slowapi rate limiter).

    Returns:
        Aggregates only — counts, percentiles, route templates, coarse
        dependency states. No request bodies, no headers, no user identifiers,
        no connection strings.
    """
    return await dashboard_payload()
