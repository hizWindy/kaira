{% from "_docker_macros.j2" import service_block %}
# docker-compose.prod.yml — PRODUCTION stack for {{ project_name }}.
#
# Generated by Kaira from the current project state:
#   database: {{ db_label }}{% if cache %} · cache: redis{% endif %}{% if task %} · tasks: celery{% endif %}{% if search %} · search: {{ search }}{% endif %}

#
# Differences from the development file, all deliberate:
#   * no source bind-mount and no --reload — the image is the artefact
#   * no published database/cache/search ports — those stay on the internal
#     network, reachable only by the services that need them
#   * read_only root filesystem plus a size-capped tmpfs on the app and worker
#   * no-new-privileges on every service
#   * json-file log rotation so a long-running host cannot fill its disk
#   * restart: always and memory/CPU limits on the app and worker
#
# Secrets come from .env.production via --env-file or from the orchestrator —
# never from a layer in the image.
#
# Start it with `kaira docker up --prod` (typed confirmation required).
# Regenerate after project changes with `kaira docker sync`.

services:
{% for svc in services %}
{{ service_block(svc) }}
{% endfor %}
{% if volume_names %}
volumes:
{% for name in volume_names %}
  {{ name }}:
{% endfor %}
{% endif %}
