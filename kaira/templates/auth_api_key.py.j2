"""API Key Authentication Module."""

from datetime import datetime, timezone
import secrets
from fastapi import Security, HTTPException, status
from fastapi.security.api_key import APIKeyHeader
from sqlalchemy import select
from sqlalchemy.orm import Session
import bcrypt

from core.database import get_db

API_KEY_NAME = "X-API-Key"
api_key_header = APIKeyHeader(name=API_KEY_NAME, auto_error=False)

# Try importing model if generated
try:
    from models.api_key import ApiKey
except ImportError:
    ApiKey = None

def generate_new_api_key() -> str:
    """Generate a new secure plain text API Key."""
    return f"df_{secrets.token_urlsafe(32)}"

def hash_api_key(key: str) -> str:
    """Hash API key with bcrypt."""
    salt = bcrypt.gensalt(rounds=12)
    return bcrypt.hashpw(key.encode("utf-8"), salt).decode("utf-8")

def verify_api_key(plain_key: str, hashed_key: str) -> bool:
    """Verify plain key against hashed key using bcrypt."""
    # Enforce safe comparison preventing timing attacks
    return bcrypt.checkpw(plain_key.encode("utf-8"), hashed_key.encode("utf-8"))

async def validate_api_key(
    api_key_str: str = Security(api_key_header),
    db: Session = Security(get_db)
):
    """Dependency to validate the API key header."""
    if not api_key_str:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="API Key missing"
        )
    
    if ApiKey is None:
        # Fallback if DB table is not created yet
        return {"app": "fallback"}

    # Fetch active API keys
    # Note: To avoid timing attacks, hash verify is run on matches
    # Since plain key is not stored, we verify it
    # We query keys that are not expired
    now = datetime.now(timezone.utc)
    keys = db.execute(select(ApiKey).where((ApiKey.expires_at == None) | (ApiKey.expires_at > now))).scalars().all()
    
    for key_record in keys:
        if verify_api_key(api_key_str, key_record.hashed_key):
            return key_record

    raise HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Invalid or expired API Key"
    )
