"""Khaira Framework — Library Abstraction Layer.

All generated code uses `from kaira import ...` instead of raw library imports.
This template defines the abstraction for every supported library.

Every library in the ecosystem is wrapped behind a kaira.* import.
The developer never imports sqlalchemy, jwt, slowapi, or any other
external library directly.
"""

from __future__ import annotations

# ── Model Abstraction ────────────────────────────────────────────────────
# Developer writes:    from kaira import Model
# Framework generates: based on .kaira.json "orm" setting
#
# Supported ORMs:
#   - sqlalchemy  → SQLAlchemy DeclarativeBase
#   - sqlmodel    → sqlmodel.SQLModel
#   - beanie      → Beanie Document
#   - peewee      → Peewee Model
#   - tortoise    → TortoiseORM

