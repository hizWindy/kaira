# Railway deployment configuration for {{ project_name }}
# Generated by DevFlow. Credentials are referenced via Railway secret store —
# never hardcoded in this file.

[build]
builder = "NIXPACKS"

[deploy]
startCommand = "uvicorn main:app --host 0.0.0.0 --port $PORT"
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 3

[[services]]
name = "{{ project_name }}"
