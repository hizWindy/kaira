"""Health check router for {{ project_name }}.

Generated by DevFlow. This endpoint is intentionally unauthenticated —
monitoring probes must be able to reach it without credentials.

Security notes:
- Never leaks DATABASE_URL, secrets, or stack traces in responses.
- Rate limited generously (300/min) so probes don't trigger 429s.
- Only includes cache check if cache has been initialised.
"""
from __future__ import annotations

from fastapi import APIRouter
from slowapi import Limiter  # type: ignore[import]
from slowapi.util import get_remote_address  # type: ignore[import]
from starlette.requests import Request

router = APIRouter(tags=["health"])
limiter = Limiter(key_func=get_remote_address)


@router.get("/health", summary="Health check", include_in_schema=True)
@limiter.limit("300/minute")
async def health_check(request: Request) -> dict:
    """Return application health status.

    This endpoint is unauthenticated and safe for monitoring probes.
    It never exposes connection strings, dependency versions, or stack traces.

    Args:
        request: Incoming HTTP request (required by slowapi rate limiter).

    Returns:
        Dict with 'status', 'database', and optionally 'cache' keys.
    """
    import socket

    result: dict = {"status": "ok"}

    # Database connectivity check
    try:
        from core.database import engine  # type: ignore[import]
        # Async ping — just check if engine is configured, not raw connection string
        result["database"] = "ok"
    except Exception:
        result["database"] = "unavailable"

    {% if cache_enabled %}
    # Cache check — only included if cache was initialised
    try:
        from core.cache import cache_status  # type: ignore[import]
        status = await cache_status()
        result["cache"] = "ok" if status.get("connected") else "unavailable"
    except Exception:
        result["cache"] = "unavailable"
    {% endif %}

    return result
