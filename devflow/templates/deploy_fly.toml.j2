# Fly.io deployment configuration for {{ project_name }}
# Generated by DevFlow. Secrets are managed via `fly secrets set` —
# never stored in this file.

app = "{{ project_name }}"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1
