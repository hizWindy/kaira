"""Feature flags for {{ project_name }}.

Generated by DevFlow. Flags default to False when unknown (fail-closed).
Never fail open — unknown flags must be explicitly enabled.

Usage:
    from core.flags import is_enabled

    if is_enabled("my_feature"):
        # feature is active
"""
from __future__ import annotations

# Feature flags registry.
# Keys must be snake_case. Values are booleans.
FEATURE_FLAGS: dict[str, bool] = {
    {% for flag in flags %}
    "{{ flag.name }}": {{ flag.default | title }},
    {% endfor %}
}


def is_enabled(flag_name: str) -> bool:
    """Check whether a feature flag is enabled.

    Defaults to False for unknown flags (fail-closed behaviour).
    Never returns True for an undefined flag.

    Args:
        flag_name: The snake_case flag name to look up.

    Returns:
        True if the flag is defined and set to True, False otherwise.
    """
    return FEATURE_FLAGS.get(flag_name, False)
