"""FastAPI lifespan shutdown handler for {{ project_name }}.

Generated by DevFlow. Registered via the FastAPI lifespan context manager —
not the deprecated @app.on_event("shutdown").
"""
from __future__ import annotations

from core.logger import logger  # type: ignore[import]


async def on_shutdown() -> None:
    """Run application shutdown tasks.

    Called once when the FastAPI application stops. Closes all connections
    and flushes any pending operations gracefully.
    """
    logger.info("Application shutting down...")

    {% if cache_enabled %}
    # Close Redis cache connection pool
    try:
        from core.cache import _redis_client  # type: ignore[import]
        if _redis_client is not None:
            await _redis_client.close()
            logger.info("Cache connection closed")
    except Exception as exc:
        logger.warning("Cache shutdown error: {}", type(exc).__name__)
    {% endif %}

    logger.info("Shutdown complete")
