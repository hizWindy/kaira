[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "FastAPI application powered by DevFlow"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "fastapi==0.115.0",
    "uvicorn[standard]==0.29.0",
    "pydantic==2.10.0",
    "pydantic-settings==2.7.0",
    "slowapi==0.1.9",
    "loguru==0.7.2",
    "python-dotenv==1.0.1",
    "bcrypt==4.1.2",
    
    # Auth dependencies (always included for simplicity and guard layers)
    "python-jose[cryptography]==3.3.0",
    "passlib[bcrypt]==1.7.4",

    {% if db_type == "postgresql" %}
    "sqlalchemy[asyncio]==2.0.36",
    "asyncpg==0.30.0",
    "alembic==1.14.0",
    {% elif db_type == "mysql" %}
    "sqlalchemy[asyncio]==2.0.36",
    "aiomysql==0.2.0",
    "alembic==1.14.0",
    {% elif db_type == "mongodb" %}
    "motor==3.6.0",
    "beanie==1.27.0",
    {% elif db_type == "sqlite" %}
    "sqlalchemy[asyncio]==2.0.36",
    "aiosqlite==0.20.0",
    "alembic==1.14.0",
    {% endif %}
]

[tool.ruff]
line-length = 120
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "C4", "SIM", "ARG"]
ignore = ["B008"]
