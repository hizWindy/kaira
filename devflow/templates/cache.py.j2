async def get_cache(key: str) -> Optional[str]:
    """Retrieve a value from the cache by key.

    Args:
        key: The cache key to look up.

    Returns:
        The cached value string, or None if not found or cache unavailable.
    """
    if _redis_client is None:
        return None
    try:
        return await _redis_client.get(key)
    except Exception:
        return None


async def set_cache(key: str, value: str, ttl: int = 300) -> bool:
    """Store a value in the cache with a TTL.

    Args:
        key: The cache key.
        value: The string value to store.
        ttl: Time-to-live in seconds (default 300).

    Returns:
        True if the value was stored successfully, False otherwise.
    """
    if _redis_client is None:
        return False
    try:
        await _redis_client.setex(key, ttl, value)
        return True
    except Exception:
        return False


async def clear_cache(pattern: str = "*") -> int:
    """Delete cache keys matching a pattern.

    Args:
        pattern: Redis key glob pattern (default "*" clears everything).

    Returns:
        Number of keys deleted.
    """
    if _redis_client is None:
        return 0
    try:
        keys = await _redis_client.keys(pattern)
        if not keys:
            return 0
        return await _redis_client.delete(*keys)
    except Exception:
        return 0


async def cache_status() -> dict[str, Any]:
    """Return cache connection status and key count.

    Returns:
        Dict with 'connected' bool and 'key_count' int.
    """
    if _redis_client is None:
        return {"connected": False, "key_count": 0}
    try:
        await _redis_client.ping()
        key_count = len(await _redis_client.keys("*"))
        return {"connected": True, "key_count": key_count}
    except Exception:
