# Render deployment configuration for {{ project_name }}
# Generated by DevFlow. Credentials are referenced via Render secret store —
# never hardcoded in this file.

services:
  - type: web
    name: {{ project_name }}
    env: python
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: DATABASE_URL
        fromGroup: {{ project_name }}-secrets
      - key: SECRET_KEY
        fromGroup: {{ project_name }}-secrets
      - key: APP_ENV
        value: production
