from __future__ import annotations

from typing import Optional

from fastapi import HTTPException, status
from google.cloud import firestore  # type: ignore[import]

from .repositories.{{ model_name_lower }} import {{ model_name }}Repository
from .schemas.{{ model_name_lower }} import (
    {{ model_name }}Create,
    {{ model_name }}ListResponse,
    {{ model_name }}Response,
    {{ model_name }}Update,
)


class {{ model_name }}Service:
    """Business logic layer for :class:`{{ model_name }}`.

    Sits between the FastAPI router and the Firestore repository.
    All external inputs are validated Pydantic schemas — never raw dicts
    from untrusted sources.
    """

    def __init__(self, db: firestore.AsyncClient) -> None:
        """Initialise with an async Firestore client.

        Args:
            db: Async Firestore client shared from the FastAPI lifespan.
        """
        self._repo = {{ model_name }}Repository(db)

    # ------------------------------------------------------------------
    # Read
    # ------------------------------------------------------------------

    async def get(self, document_id: str) -> {{ model_name }}Response:
        """Return a single {{ model_name }} by UUID.

        Args:
            document_id: UUID document identifier.

        Returns:
            :class:`{{ model_name }}Response` schema.

        Raises:
            :class:`fastapi.HTTPException`: 404 if not found.
        """
        doc = await self._repo.get_by_id(document_id)
        if doc is None:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="{{ model_name }} not found.",
            )
        return {{ model_name }}Response(**doc.model_dump())

    async def list_all(
        self, limit: int = 100, offset: int = 0
    ) -> {{ model_name }}ListResponse:
        """Return paginated {{ model_name }} list.

        Args:
            limit: Maximum number of items (capped at 500).
            offset: Number of items to skip.

        Returns:
            :class:`{{ model_name }}ListResponse` with items and pagination info.
        """
        limit = min(limit, 500)  # enforce maximum page size
        docs = await self._repo.list_all(limit=limit, offset=offset)
        items = [{{ model_name }}Response(**d.model_dump()) for d in docs]
        return {{ model_name }}ListResponse(
            items=items,
            total=len(items),
            limit=limit,
            offset=offset,
        )

    # ------------------------------------------------------------------
    # Write
    # ------------------------------------------------------------------

    async def create(self, payload: {{ model_name }}Create) -> {{ model_name }}Response:
        """Create a new {{ model_name }} document.

        Args:
            payload: Validated :class:`{{ model_name }}Create` schema.

        Returns:
            Created :class:`{{ model_name }}Response`.
        """
        data = payload.model_dump()
{% if has_password_field %}
        # Hash password before persistence — never store plaintext
        import bcrypt
        if "password" in data and data["password"]:
            data["password"] = bcrypt.hashpw(
                data["password"].encode(), bcrypt.gensalt(rounds=12)
            ).decode()
{% endif %}
        doc = await self._repo.create(data)
        return {{ model_name }}Response(**doc.model_dump())

    async def update(
        self, document_id: str, payload: {{ model_name }}Update
    ) -> {{ model_name }}Response:
        """Partially update a {{ model_name }} document.

        Args:
            document_id: UUID of the document to update.
            payload: Validated :class:`{{ model_name }}Update` schema.

        Returns:
            Updated :class:`{{ model_name }}Response`.

        Raises:
            :class:`fastapi.HTTPException`: 404 if not found.
        """
        data = {k: v for k, v in payload.model_dump().items() if v is not None}
        doc = await self._repo.update(document_id, data)
        if doc is None:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="{{ model_name }} not found.",
            )
        return {{ model_name }}Response(**doc.model_dump())

    async def delete(self, document_id: str) -> None:
        """Delete a {{ model_name }} document.

        Args:
            document_id: UUID of the document to delete.

        Raises:
            :class:`fastapi.HTTPException`: 404 if not found.
        """
        deleted = await self._repo.delete(document_id)
        if not deleted:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="{{ model_name }} not found.",
            )
